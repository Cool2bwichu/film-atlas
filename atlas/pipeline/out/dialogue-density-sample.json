{
 "_meta": {
  "what": "Dialogue-density trial: stratified 109-film sample measured from OpenSubtitles timing via OPUS",
  "date": "2026-08-09",
  "source": "OPUS OpenSubtitles v2018 (opus.nlpl.eu/OpenSubtitles-v2018.php), raw/en corpus. Subtitles originate from opensubtitles.org — cite: P. Lison, J. Tiedemann (2016), OpenSubtitles2016, LREC. Please acknowledge opensubtitles.org.",
  "licence": "OPUS is research-open. This file stores DERIVED numbers only; no subtitle text is stored in this repository, per the enrichment report's licence guidance.",
  "matching": "harvest QID -> Wikidata P345 IMDb id (SPARQL, 109/109 resolved) -> OPUS path raw/en/<year>/<imdb-numeric>/. Runtime = Wikidata P2047 minutes, median-low over non-deprecated statements (106/109).",
  "fileChoice": "median-size upload per film; accepted when last subtitle timestamp / P2047 runtime is in [0.80, 1.12] (83/84 accepted; 1 runtime-mismatch kept flagged).",
  "metrics": {
   "wpm": "total subtitle words / P2047 runtime minutes. For non-English films this is the ENGLISH TRANSLATION's word count: subtitle condensation makes it a lower bound; comparable within-language, conservative across.",
   "speechShare": "fraction of runtime covered by intervals between time cues that contain words (timing-based, language-independent)",
   "longestSilenceS": "longest interior gap between time cues containing zero words, seconds (language-independent)",
   "silences60": "count of interior wordless gaps >= 60s"
  },
  "gates": {
   "anchors": "Le Samourai 28.8 wpm (10th pct, longest silence 7m44s) vs Network 119.2 wpm (96th pct) - PASS",
   "polePrevalence": "score = wpm scaled 0-100 between sample p5 (20.8) and p95 (99.4); >=80: 11.9%, <=20: 19.0% - both inside the 5-35% band - PASS",
   "fameShape": "Spearman vs 60-day Wikipedia pageviews (from .cache-views, n=84): wpm 0.188, speechShare 0.145, longestSilence 0.049 - flatter than the frames pass (0.242), far from the text fail (0.856) - PASS",
   "coverageCaveat": "AVAILABILITY is fame-shaped even though the SCORE is not: median pageviews 10,153 for matched films vs 1,911 for unmatched. Same shape as the 1,500-char plot floor: a coverage gradient, not a score gradient. Films without subtitles must be null, never defaulted."
  },
  "coverage": "84/109 matched in English (77%); 84/99 (85%) for films released <=2017 - OPUS v2018 is frozen, nothing from 2018 onward exists in it. Pre-2018 misses skew obscure Japanese/Nordic/W-European 1930s-50s.",
  "silentFilmNote": "Pre-sound films measure INTERTITLE density (Earth 8.8 wpm, Passion of Joan of Arc 16.2) - real signal but a different quality; flag silents separately before shipping an axis."
 },
